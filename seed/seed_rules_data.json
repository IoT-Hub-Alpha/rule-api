{
  "rules": [
    {
      "device": "VIB-SN-001",
      "name": "Low Vibration Alert Lathe #1",
      "description": "Alerts maintenance when vibration drops below expected operating range",
      "condition": {
        "type": "leaf",
        "operator": "lt",
        "threshold": 15.0
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Critical Vibration Alert"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "TEMP-SN-002",
      "name": "Critical Temperature – CNC Mill #2",
      "description": "Stops the machine if temperature exceeds the critical threshold",
      "condition": {
        "type": "leaf",
        "operator": "gt",
        "threshold": 100.0
      },
      "action_config": [
        {
          "type": "stop_machine",
          "machine_id": "CNC-002"
        },
        {
          "type": "notification",
          "template_id": "Temperature Emergency"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "PWR-SN-003",
      "name": "High Power Consumption Warning",
      "description": "Alerts energy management when power consumption exceeds normal levels",
      "condition": {
        "type": "leaf",
        "operator": "lt",
        "threshold": 12.2
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Power Consumption Warning"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "FLW-SN-001",
      "name": "High Flow Rate Warning",
      "description": "Alerts management when flow rate exceeds safe operating limits",
      "condition": {
        "type": "or",
        "conditions": [
          {
            "type": "leaf",
            "operator": "gt",
            "threshold": 300.2
          },
          {
            "type": "leaf",
            "operator": "lt",
            "threshold": 20.0
          }
        ]
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Flow Rate Warning"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "FLW-SN-001",
      "name": "Low Flow Rate Warning",
      "description": "Alerts management when flow rate drops below minimum required levels",
      "condition": {
        "type": "leaf",
        "operator": "lt",
        "threshold": 17.4
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Flow Rate Warning"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "HMD-SN-001",
      "name": "High Humidity Warning",
      "description": "Alerts management when humidity exceeds acceptable levels",
      "condition": {
        "type": "or",
        "conditions": [
          {
            "type": "leaf",
            "operator": "gt",
            "threshold": 80
          },
          {
            "type": "leaf",
            "operator": "gt",
            "threshold": 60.5,
            "occurrences": 5,
            "window_seconds": 300
          }
        ]
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Humidity Warning"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "CUR-SN-001",
      "name": "High Current Draw Warning",
      "description": "Alerts management when electrical current draw is abnormally high",
      "condition": {
        "type": "leaf",
        "operator": "gt",
        "threshold": 120.2
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Power Consumption Warning"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "CUR-SN-001",
      "name": "Critical Current Draw Alert",
      "description": "Alerts multiple stakeholders when current draw reaches critical levels",
      "condition": {
        "type": "leaf",
        "operator": "gt",
        "threshold": 150.4
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Power Consumption Warning"
        }
      ],
      "is_enabled": true
    },
    {
      "device": "CUR-SN-003",
      "name": "Unexpected Low Current Alert",
      "description": "Alerts management when current draw indicates possible machine shutdown",
      "condition": {
        "type": "leaf",
        "operator": "gt",
        "threshold": 14.1
      },
      "action_config": [
        {
          "type": "notification",
          "template_id": "Power Consumption Warning"
        }
      ],
      "is_enabled": false
    }
  ]
}
